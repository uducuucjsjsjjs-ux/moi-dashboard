{
  "name": "moi-screenshot",
  "productName": "Мои скриншоты",
  "version": "0.2.0",
  "description": "Программа для скриншотов с редактором, негативом и сериями для лабораторных (в духе ShareX)",
  "main": "main.js",
  "author": "Me",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/logic.test.js && node test/rec-session.test.js && node test/video.test.js && node test/video-session.test.js",
    "dist": "electron-builder --win nsis portable",
    "changelog": "node tools/gen-changelog.js"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.moi.screenshot",
    "productName": "Мои скриншоты",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "rec-preload.js",
      "lib/**/*",
      "renderer/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Мои скриншоты",
      "deleteAppDataOnUninstall": false,
      "language": "1049",
      "artifactName": "Moi-Screenshot-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Moi-Screenshot-Portable-${version}.${ext}"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  }
}